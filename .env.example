# ==============================================================================
# Luma Salon — Supabase Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` or `.env` and fill in your project credentials.
# IMPORTANT:
# - NEVER commit real credentials to version control.
# - NEVER put a Supabase service_role key or secret key in frontend code.
# - The publishable / anon key is safe for client-side use when Row Level Security (RLS) is enabled.
# ==============================================================================

# Your Supabase Project URL (e.g. https://abcdefghijklmnopqrst.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Publishable / Anon Client Key (starts with "ey..." or "sb_publishable_...")
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key-here

# Authentication Mode:
# 'supabase_auth' : Use production Supabase Auth with RLS and server-side profile resolution
# 'local_mock'    : Use local offline password hash verification for development
VITE_AUTH_MODE=local_mock
